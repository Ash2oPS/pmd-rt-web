{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*\\.(svg|png|webp)$"
    },
    "frameWidth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "frameHeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "frameSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "credit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "id",
    "label",
    "path",
    "frameWidth",
    "frameHeight",
    "frames",
    "frameSeconds",
    "credit",
    "license"
  ],
  "additionalProperties": false
}
