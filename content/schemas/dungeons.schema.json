{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tileSize": {
      "type": "integer",
      "minimum": 8,
      "maximum": 128
    },
    "playerSpeciesId": {
      "default": "jigglypuff",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "map": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[#.~]+$"
      }
    },
    "spawn": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "collectibles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "itemId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "x",
          "y",
          "itemId"
        ],
        "additionalProperties": false
      }
    },
    "actors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "speciesId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "team": {
            "default": "neutral",
            "type": "string",
            "enum": [
              "neutral",
              "hostile"
            ]
          },
          "facing": {
            "type": "string",
            "enum": [
              "down",
              "down-left",
              "left",
              "up-left",
              "up",
              "up-right",
              "right",
              "down-right"
            ]
          },
          "animation": {
            "type": "string",
            "enum": [
              "Idle",
              "Walk"
            ]
          },
          "roaming": {
            "type": "object",
            "properties": {
              "radius": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 6
              },
              "behaviorMultiplier": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 2
              },
              "idleMinSeconds": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 15
              },
              "idleMaxSeconds": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 15
              }
            },
            "required": [
              "radius",
              "behaviorMultiplier",
              "idleMinSeconds",
              "idleMaxSeconds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "x",
          "y",
          "id",
          "speciesId",
          "team",
          "facing",
          "animation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "label",
    "tileSize",
    "playerSpeciesId",
    "map",
    "spawn",
    "collectibles",
    "actors"
  ],
  "additionalProperties": false
}
