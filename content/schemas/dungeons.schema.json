{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tileSize": {
      "type": "integer",
      "minimum": 8,
      "maximum": 128
    },
    "map": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[#.~]+$"
      }
    },
    "spawn": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "collectibles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "itemId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "x",
          "y",
          "itemId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "label",
    "tileSize",
    "map",
    "spawn",
    "collectibles"
  ],
  "additionalProperties": false
}
