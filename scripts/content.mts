import { readdir, readFile } from 'node:fs/promises';
import { outputContent } from './content-output.mts';
import { fileURLToPath } from 'node:url';
import { z } from 'zod';
import { recordSchemas } from '../src/content/schemas.ts';
import { validateContent } from '../src/content/validate.ts';

const root = new URL('../', import.meta.url);
const check = process.argv.includes('--check');
const categories = ['species', 'moves', 'abilities', 'items', 'dungeons', 'settings'] as const;
const raw: Record<string, unknown[]> = {};
const imports: string[] = ['// Generated by scripts/content.mts. Edit content/**/*.json instead.'];
const entries: string[] = [];

async function output(relative: string, value: string): Promise<void> {
  await outputContent(new URL(relative, root), value, check);
}

for (const category of categories) {
  const directory = new URL(`content/${category}/`, root);
  const files = (await readdir(directory)).filter((file) => file.endsWith('.json')).sort();
  raw[category] = [];
  const names: string[] = [];
  for (const [index, file] of files.entries()) {
    let record: unknown;
    let parsed: {id:string};
    try {
      record = JSON.parse(await readFile(new URL(file, directory), 'utf8'));
      parsed = recordSchemas[category].parse(record);
    } catch (error) {
      throw new Error(`content/${category}/${file}: ${error instanceof Error ? error.message : String(error)}`);
    }
    if (file !== `${parsed.id}.json`) throw new Error(`${category}/${file}: filename must match record ID ${parsed.id}`);
    raw[category].push(record);
    const name = `${category}${index}`;
    names.push(name);
    imports.push(`import ${name} from '../../content/${category}/${file}';`);
  }
  entries.push(`  ${category}: [${names.join(', ')}],`);
  const schema = z.toJSONSchema(recordSchemas[category]);
  await output(`content/schemas/${category}.schema.json`, `${JSON.stringify(schema, null, 2)}\n`);
}
validateContent(raw);
await output('src/content/manifest.ts', `${imports.join('\n')}\n\nexport const rawContent = {\n${entries.join('\n')}\n};\n`);
console.log(`Content ${check ? 'checked' : 'generated'}: ${categories.map((key) => `${raw[key]?.length} ${key}`).join(', ')} (${fileURLToPath(root)})`);
