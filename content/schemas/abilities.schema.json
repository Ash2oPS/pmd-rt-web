{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "effectId": {
      "type": "string",
      "enum": [
        "static",
        "overgrow",
        "blaze",
        "torrent",
        "run-away"
      ]
    }
  },
  "required": [
    "id",
    "label",
    "description",
    "effectId"
  ],
  "additionalProperties": false
}
