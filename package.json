{
  "name": "pmd-rt-web",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content:generate && vite",
    "build": "npm run check && vite build && node --import tsx scripts/build-offline.mts",
    "preview": "vite preview",
    "content:generate": "node --import tsx scripts/content.mts",
    "content:check": "node --import tsx scripts/content.mts --check",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node --import tsx scripts/architecture.mts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs && node tests/pokemon-browser.mjs && node tests/realtime-browser.mjs && node tests/combat-browser.mjs",
    "check": "npm run version:check && npm run pokemon:check && npm run content:check && npm run typecheck && npm run architecture:check && npm test",
    "version:check": "node --import tsx scripts/version.mts",
    "pokemon:import": "node --import tsx scripts/import-pokemon/main.mts",
    "pokemon:check": "node --import tsx scripts/import-pokemon/main.mts --check",
    "pokemon:qa": "node --import tsx scripts/qa-pokemon.mts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-xml-parser": "^5.11.2",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
