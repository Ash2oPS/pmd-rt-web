{
  "name": "pmd-rt-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content:generate && vite",
    "build": "npm run check && vite build && node --import tsx scripts/build-offline.mts",
    "preview": "vite preview",
    "content:generate": "node --import tsx scripts/content.mts",
    "content:check": "node --import tsx scripts/content.mts --check",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node --import tsx scripts/architecture.mts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run content:check && npm run typecheck && npm run architecture:check && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
