{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "type": "string",
      "enum": [
        "normal",
        "fire",
        "water",
        "electric",
        "grass",
        "ice",
        "fighting",
        "poison",
        "ground",
        "flying",
        "psychic",
        "bug",
        "rock",
        "ghost",
        "dragon",
        "dark",
        "steel",
        "fairy"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "physical",
        "special",
        "status"
      ]
    },
    "power": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "accuracy": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "pp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "effectId": {
      "type": "string",
      "enum": [
        "damage",
        "lower-attack",
        "sleep"
      ]
    },
    "combat": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "preparationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            },
            "trackingSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "activeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "recoverySeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "cooldownSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "movementDuringPreparation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pattern": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "sector"
                    },
                    "range": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    },
                    "angleDegrees": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 360
                    }
                  },
                  "required": [
                    "kind",
                    "range",
                    "angleDegrees"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "self-disk"
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    }
                  },
                  "required": [
                    "kind",
                    "radius"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "target-disk"
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    },
                    "targetingRange": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    }
                  },
                  "required": [
                    "kind",
                    "radius",
                    "targetingRange"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "projectile"
                    },
                    "range": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 4
                    },
                    "speed": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 40
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0.025,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "kind",
                    "range",
                    "width",
                    "speed",
                    "radius"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "effect": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "damage"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "sleep"
                    },
                    "durationSeconds": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 20
                    },
                    "wakeOnHit": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "durationSeconds",
                    "wakeOnHit"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "preparationSeconds",
            "trackingSeconds",
            "activeSeconds",
            "recoverySeconds",
            "cooldownSeconds",
            "movementDuringPreparation",
            "pattern",
            "effect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "preparationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            },
            "trackingSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "activeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "recoverySeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "cooldownSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "movementDuringPreparation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "range": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 12
            },
            "angleDegrees": {
              "type": "number",
              "minimum": 1,
              "maximum": 360
            },
            "damage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            }
          },
          "required": [
            "preparationSeconds",
            "trackingSeconds",
            "activeSeconds",
            "recoverySeconds",
            "cooldownSeconds",
            "movementDuringPreparation",
            "range",
            "angleDegrees",
            "damage"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "label",
    "type",
    "category",
    "power",
    "accuracy",
    "pp",
    "effectId"
  ],
  "additionalProperties": false
}
