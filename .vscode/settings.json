{
  "json.schemas": [
    {
      "fileMatch": [
        "/content/species/*.json"
      ],
      "url": "./content/schemas/species.schema.json"
    },
    {
      "fileMatch": [
        "/content/moves/*.json",
        "/content/lab-fixtures/*.json"
      ],
      "url": "./content/schemas/moves.schema.json"
    },
    {
      "fileMatch": [
        "/content/abilities/*.json"
      ],
      "url": "./content/schemas/abilities.schema.json"
    },
    {
      "fileMatch": [
        "/content/items/*.json"
      ],
      "url": "./content/schemas/items.schema.json"
    },
    {
      "fileMatch": [
        "/content/dungeons/*.json"
      ],
      "url": "./content/schemas/dungeons.schema.json"
    },
    {
      "fileMatch": [
        "/content/settings/*.json"
      ],
      "url": "./content/schemas/settings.schema.json"
    },
    {
      "fileMatch": [
        "/content/attack-visuals/*.json"
      ],
      "url": "./content/schemas/attack-visuals.schema.json"
    },
    {
      "fileMatch": [
        "/content/effect-assets/*.json"
      ],
      "url": "./content/schemas/effect-assets.schema.json"
    }
  ]
}
