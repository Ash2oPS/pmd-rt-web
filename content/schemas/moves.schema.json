{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "type": "string",
      "enum": [
        "normal",
        "fire",
        "water",
        "electric",
        "grass",
        "ice",
        "fighting",
        "poison",
        "ground",
        "flying",
        "psychic",
        "bug",
        "rock",
        "ghost",
        "dragon",
        "dark",
        "steel",
        "fairy"
      ]
    },
    "sourceMoveId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "string",
      "enum": [
        "physical",
        "special",
        "status"
      ]
    },
    "power": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "accuracy": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "pp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "effectId": {
      "type": "string",
      "enum": [
        "damage",
        "lower-attack",
        "sleep"
      ]
    },
    "combat": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "preparationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            },
            "trackingSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "activeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "recoverySeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "cooldownSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "movementDuringPreparation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pattern": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "zones"
                    },
                    "shape": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "disk"
                            },
                            "radius": {
                              "type": "number",
                              "minimum": 0.05,
                              "maximum": 12
                            }
                          },
                          "required": [
                            "kind",
                            "radius"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "sector"
                            },
                            "range": {
                              "type": "number",
                              "minimum": 0.05,
                              "maximum": 12
                            },
                            "angleDegrees": {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 360
                            }
                          },
                          "required": [
                            "kind",
                            "range",
                            "angleDegrees"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "ring"
                            },
                            "innerRadius": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 12
                            },
                            "outerRadius": {
                              "type": "number",
                              "minimum": 0.05,
                              "maximum": 12
                            },
                            "angleDegrees": {
                              "default": 360,
                              "type": "number",
                              "minimum": 1,
                              "maximum": 360
                            }
                          },
                          "required": [
                            "kind",
                            "innerRadius",
                            "outerRadius",
                            "angleDegrees"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "line"
                            },
                            "length": {
                              "type": "number",
                              "minimum": 0.05,
                              "maximum": 12
                            },
                            "width": {
                              "type": "number",
                              "minimum": 0.05,
                              "maximum": 4
                            }
                          },
                          "required": [
                            "kind",
                            "length",
                            "width"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "placement": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "caster"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "target"
                            },
                            "targetingRange": {
                              "type": "number",
                              "minimum": 0.05,
                              "maximum": 12
                            }
                          },
                          "required": [
                            "kind",
                            "targetingRange"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "forward"
                            },
                            "distance": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 12
                            }
                          },
                          "required": [
                            "kind",
                            "distance"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "distribution": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "single"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "offsets"
                            },
                            "offsets": {
                              "minItems": 1,
                              "maxItems": 16,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "type": "number",
                                    "minimum": -12,
                                    "maximum": 12
                                  },
                                  "y": {
                                    "type": "number",
                                    "minimum": -12,
                                    "maximum": 12
                                  }
                                },
                                "required": [
                                  "x",
                                  "y"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "offsets"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "random-disk"
                            },
                            "count": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 16
                            },
                            "radius": {
                              "type": "number",
                              "minimum": 0.05,
                              "maximum": 12
                            }
                          },
                          "required": [
                            "kind",
                            "count",
                            "radius"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "circle"
                            },
                            "count": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 16
                            },
                            "radius": {
                              "type": "number",
                              "minimum": 0.05,
                              "maximum": 12
                            }
                          },
                          "required": [
                            "kind",
                            "count",
                            "radius"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "motion": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "fixed"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "orbit"
                            },
                            "angularSpeedDegrees": {
                              "type": "number",
                              "minimum": -720,
                              "maximum": 720
                            },
                            "followCaster": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "kind",
                            "angularSpeedDegrees",
                            "followCaster"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "waves": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 8
                        },
                        "intervalSeconds": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 10
                        },
                        "activeSeconds": {
                          "type": "number",
                          "minimum": 0.02,
                          "maximum": 20
                        }
                      },
                      "required": [
                        "count",
                        "intervalSeconds",
                        "activeSeconds"
                      ],
                      "additionalProperties": false
                    },
                    "hitPolicy": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "once-per-cast"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "once-per-zone"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "periodic"
                            },
                            "intervalSeconds": {
                              "type": "number",
                              "minimum": 0.05,
                              "maximum": 10
                            },
                            "maxHitsPerTarget": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 64
                            }
                          },
                          "required": [
                            "kind",
                            "intervalSeconds",
                            "maxHitsPerTarget"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "shape",
                    "placement",
                    "distribution",
                    "motion",
                    "waves",
                    "hitPolicy"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "sector"
                    },
                    "range": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    },
                    "angleDegrees": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 360
                    }
                  },
                  "required": [
                    "kind",
                    "range",
                    "angleDegrees"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "self-disk"
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    }
                  },
                  "required": [
                    "kind",
                    "radius"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "target-disk"
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    },
                    "targetingRange": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    }
                  },
                  "required": [
                    "kind",
                    "radius",
                    "targetingRange"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "projectile"
                    },
                    "range": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 4
                    },
                    "speed": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 40
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0.025,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "kind",
                    "range",
                    "width",
                    "speed",
                    "radius"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "effect": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "damage"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "sleep"
                    },
                    "durationSeconds": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 20
                    },
                    "wakeOnHit": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "durationSeconds",
                    "wakeOnHit"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "preparationSeconds",
            "trackingSeconds",
            "activeSeconds",
            "recoverySeconds",
            "cooldownSeconds",
            "movementDuringPreparation",
            "pattern",
            "effect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "preparationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            },
            "trackingSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "activeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "recoverySeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "cooldownSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "movementDuringPreparation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "range": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 12
            },
            "angleDegrees": {
              "type": "number",
              "minimum": 1,
              "maximum": 360
            },
            "damage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            }
          },
          "required": [
            "preparationSeconds",
            "trackingSeconds",
            "activeSeconds",
            "recoverySeconds",
            "cooldownSeconds",
            "movementDuringPreparation",
            "range",
            "angleDegrees",
            "damage"
          ],
          "additionalProperties": false
        }
      ]
    },
    "visualId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "visualOverrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "sizePixels": {
            "type": "number",
            "minimum": 1,
            "maximum": 128
          },
          "offset": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -12,
                "maximum": 12
              },
              "y": {
                "type": "number",
                "minimum": -12,
                "maximum": 12
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "delaySeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "speedTilesPerSecond": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "spreadDegrees": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "trailLengthTiles": {
            "type": "number",
            "minimum": 0,
            "maximum": 12
          },
          "layer": {
            "type": "string",
            "enum": [
              "ground",
              "overlay"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "label",
    "type",
    "category",
    "power",
    "accuracy",
    "pp",
    "effectId"
  ],
  "additionalProperties": false
}
